---
import { Container } from '@components/odyssey-theme'
import settings from '../../../config/settings'
import Layout from '../../../layouts/Page.astro'
import { generateTagData } from '../../../utils/helpers'

export async function getStaticPaths() {
  const allPosts = Object.values(await import.meta.glob('../../posts/*.mdx', { eager: true }))
  const sortedPosts = allPosts.sort(
    (a, b) => new Date(b.frontmatter.eventDate).valueOf() - new Date(a.frontmatter.eventDate).valueOf(),
  )
  const allCategoriesUnique = new Set()

  for (const post of sortedPosts) {
    for (const tag of post.frontmatter.tags ?? []) {
      allCategoriesUnique.add(tag)
    }
  }

  const allCategoriesData = generateTagData(allCategoriesUnique)
  // map through the categories array
  return allCategoriesData.map(tag => {
    // filter the posts that match the given category
    const posts = sortedPosts.filter(post => post.frontmatter.tags?.includes(tag.title))
    return {
      params: { slug: tag.slug },
      props: {
        tag: tag.title,
        posts: posts,
      },
    }
  })
}

const { tag, posts } = Astro.props

const seo = {
  title: `${tag} | ${settings.name}`,
}
---

<Layout seo={seo}>
  <Container narrow>
    <section class="tag-page__section">
      <h1>Évènements tagués « {tag} »</h1>
      <ul>
        {
          posts.map((post) => (
            <li>
              <a href={post.url}>{post.frontmatter.title}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</Layout>

<style>
  .tag-page__section {
    min-height: 60vh;
    margin: var(--section-margin);
  }
</style>
